{
  "frameworkName": "GCSP Leadership Attribute Framework",
  "version": "2.0.0",
  "ratings": ["Needs Improvement", "Meets Expectations", "Differentiating", "Strategic Impact"],
  "dimensions": [
    {
      "id": "D1",
      "name": "Client Impact",
      "description": "Demonstrates measurable value delivery and deepened client relationships.",
