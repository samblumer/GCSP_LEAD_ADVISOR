        "NeedsImprovement": {
          "signals": ["missed deadline", "client escalation", "quality issue", "incomplete deliverable", "client dissatisfied", "scope miss", "client complaint", "rework required"]
        },
        "MeetsExpectations": {
          "signals": ["delivered on time", "met client expectations", "client satisfied", "completed deliverable", "quality output", "responsive to client", "on budget", "client feedback positive", "repeat engagement", "client trust"]
        },
        "Differentiating": {
          "signals": ["exceeded client expectations", "proactive insight", "expanded client scope", "trusted advisor", "client referral", "innovative solution", "client commended", "went beyond", "client praised", "anticipate client needs", "client relationship deepened", "unsolicited praise"]
        },
        "StrategicImpact": {
          "signals": ["transformative client outcome", "enterprise-wide impact", "client board", "strategic client partnership", "market-shifting", "executive sponsor", "drove major client decision", "named in client success", "flagship engagement", "led firm-wide client initiative"]
        }
      },
      "attributes": [
