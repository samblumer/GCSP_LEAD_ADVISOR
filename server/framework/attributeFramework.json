        "Differentiating": {
          "signals": ["exceeded revenue target", "closed new business", "new logo", "grew account", "pipeline generated", "led proposal win", "business development", "revenue exceeded", "won competitive deal", "expanded existing client revenue", "identified new opportunity", "drove new revenue"]
